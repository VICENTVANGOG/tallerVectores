import java.util.Random;

public class CuadradoMagico {

    public static void main(String[] args) {

        Random aleatorio = new Random();

        int dimension = 5;
        int[][] matriz = new int[dimension][dimension];

        // Llenar con números aleatorios
        for (int fila = 0; fila < dimension; fila++) {
            for (int columna = 0; columna < dimension; columna++) {
                matriz[fila][columna] = aleatorio.nextInt(10) + 1;
            }
        }

        int sumaObjetivo = 0;

        // Suma de la primera fila
        for (int columna = 0; columna < dimension; columna++) {
            sumaObjetivo += matriz[0][columna];
        }

        boolean esMagico = true;

        // Verificar filas
        for (int fila = 1; fila < dimension; fila++) {

            int sumaFila = 0;

            for (int columna = 0; columna < dimension; columna++) {
                sumaFila += matriz[fila][columna];
            }

            if (sumaFila != sumaObjetivo) {
                esMagico = false;
                break;
            }
        }

        // Verificar columnas
        if (esMagico) {

            for (int columna = 0; columna < dimension; columna++) {

                int sumaColumna = 0;

                for (int fila = 0; fila < dimension; fila++) {
                    sumaColumna += matriz[fila][columna];
                }

                if (sumaColumna != sumaObjetivo) {
                    esMagico = false;
                    break;
                }
            }
        }

        // Diagonal principal
        if (esMagico) {

            int sumaDiagonalPrincipal = 0;

            for (int i = 0; i < dimension; i++) {
                sumaDiagonalPrincipal += matriz[i][i];
            }

            if (sumaDiagonalPrincipal != sumaObjetivo) {
                esMagico = false;
            }
        }

        // Diagonal secundaria
        if (esMagico) {

            int sumaDiagonalSecundaria = 0;

            for (int i = 0; i < dimension; i++) {
                sumaDiagonalSecundaria += matriz[i][dimension - 1 - i];
            }

            if (sumaDiagonalSecundaria != sumaObjetivo) {
                esMagico = false;
            }
        }

        System.out.println("Matriz:");

        for (int fila = 0; fila < dimension; fila++) {
            for (int columna = 0; columna < dimension; columna++) {
                System.out.print(matriz[fila][columna] + "\t");
            }
            System.out.println();
        }

        if (esMagico) {
            System.out.println("La matriz es un cuadrado mágico.");
        } else {
            System.out.println("La matriz no es un cuadrado mágico.");
        }
    }
}
